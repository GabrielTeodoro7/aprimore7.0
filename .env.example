# Aprimore Educação — Configurações Locais
# Copie este arquivo para .env.local para desenvolvimento no VS Code

# --- SUPABASE (Obrigatório para Backend Real) ---
# Encontre em: Projeto Supabase > Settings > API
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"

# --- SERVICE ROLE (Apenas para funçães administrativas) ---
# CUIDADO: Nunca publique esta chave no GitHub.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- INTELIGÊNCIA ARTIFICIAL ---
# Se ausente, o sistema usará o fallback fixo (Groq Llama 3.3) configurado no código.
# LOVABLE_API_KEY="seu-token-lovable"

# --- DESENVOLVIMENTO ---
VITE_APP_ENV="local"
