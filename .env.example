# Configure no ambiente do servidor; o Java não carrega este arquivo automaticamente.
DB_URL=jdbc:mysql://localhost:3306/aprimore
DB_USER=aprimore_app
DB_PASSWORD=
SESSION_COOKIE_SECURE=true

# SMTP autenticado com STARTTLS para recuperação de senha.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Integração opcional do tutor pedagógico.
